"""SACLA TMAUserAPI, tmapy 1.0.1 – Timing Monitor Analysis results in the User DataBase.

Three objects:
  UdbParamBuffer  analysis *parameters* (read with UdbCtrlObject.collect_udbparam)
  UdbDataBuffer   analysis *results* per tag (read with collect_udbdata / retrieve_udbdata)
  UdbCtrlObject   connection to the UDB (needs the SACLA UDB servers)

Fit model parameters: a, b_plus, b_minus, c, sigma, t_edge. "*_check" values are
integer on/off flags for the corresponding parameter.
Hand-written stub from TMAUserAPI/1.0.1/python/tmapy.cpp.
"""
from typing import final
import numpy as np
from numpy.typing import NDArray

_Six = tuple[float, float, float, float, float, float]
_SixFlags = tuple[int, int, int, int, int, int]

class APIError(Exception):
    """Raised on any API failure. ``args == (error_code, error_name)``;
    compare ``args[0]`` with the ``TMA_ERR_*`` constants."""
    args: tuple[int, str]

@final
class UdbParamBuffer:
    """TMA analysis parameters."""
    def __init__(self) -> None: ...
    # --- read
    def readparam_hostname(self) -> str: ...
    def readparam_directory(self) -> tuple[str, str]:
        """(log_dir, work_dir)."""
    def readparam_detid(self) -> str: ...
    def readparam_algorithmindex(self) -> int: ...
    def readparam_edgedirection(self) -> str: ...
    def readparam_lineprofile(self) -> tuple[int, int]:
        """(low, high) limits of the line-profile ROI."""
    def readparam_timewindow_base(self) -> tuple[int, int, int, int]:
        """Centres (first, last, end, baseline) of the time windows."""
    def readparam_timewindow_range(self) -> tuple[int, int, int, int]:
        """Widths (first, last, end, baseline) of the time windows."""
    def readparam_offsetrange(self) -> tuple[int, int]: ...
    def readparam_smoothing_method(self) -> int:
        """0 kernel smoother, 1 low-pass, 2 B-spline, 3 moving average."""
    def readparam_smoothing_param(self, method: int, /) -> int: ...
    def readparam_peaksearch_method(self) -> int: ...
    def readparam_peaksearch_relative(self) -> float: ...
    def readparam_fitrange(self) -> tuple[int, int]: ...
    def readparam_fitinitval(self) -> _Six: ...
    def readparam_fitinitval_check(self) -> _SixFlags: ...
    def readparam_fitlimit(self) -> tuple[float, float, float, float, float, float, float, float, float, float, float, float]:
        """(a_low, a_high, b_plus_low, b_plus_high, b_minus_low, b_minus_high,
        c_low, c_high, sigma_low, sigma_high, t_edge_low, t_edge_high)."""
    def readparam_fitlimit_check(self) -> _SixFlags: ...
    def readparam_fitfix(self) -> _Six: ...
    def readparam_fitfix_check(self) -> _SixFlags: ...
    def readparam_qualitycheck(self) -> _Six:
        """Thresholds (dR_first, dR_last, dR_end, R_baseline, N_edge/N_baseline, DeltaT_edge)."""
    def readparam_qualitycheck_check(self) -> _SixFlags: ...
    def readparam_tagincrement(self) -> int: ...
    def readparam_bgdata(self) -> NDArray[np.float64]:
        """Background: 1-D projection of 1920 float64 values."""
    # --- set
    def setparam_hostname(self, hostName: str, /) -> None: ...
    def setparam_directory(self, logDir: str, workDir: str, /) -> None: ...
    def setparam_detid(self, detID: str, /) -> None: ...
    def setparam_algorithmindex(self, algoIdx: int, /) -> None: ...
    def setparam_edgedirection(self, edgeDir: str, /) -> None: ...
    def setparam_lineprofile(self, low: int, high: int, /) -> None: ...
    def setparam_timewindow_base(self, first: int, last: int, end: int, baseline: int, /) -> None: ...
    def setparam_timewindow_range(self, first: int, last: int, end: int, baseline: int, /) -> None: ...
    def setparam_offsetrange(self, low: int, high: int, /) -> None: ...
    def setparam_smoothing_method(self, method: int, /) -> None: ...
    def setparam_smoothing_param(self, param: int, method: int, /) -> None: ...
    def setparam_peaksearch_method(self, method: int, /) -> None: ...
    def setparam_peaksearch_relative(self, param: float, /) -> None: ...
    def setparam_fitrange(self, low: int, high: int, /) -> None: ...
    def setparam_fitinitval(self, a: float, b_plus: float, b_minus: float, c: float, sigma: float, t_edge: float, /) -> None: ...
    def setparam_fitinitval_check(self, a: int, b_plus: int, b_minus: int, c: int, sigma: int, t_edge: int, /) -> None: ...
    def setparam_fitlimit(
        self, a_low: float, a_high: float, b_plus_low: float, b_plus_high: float,
        b_minus_low: float, b_minus_high: float, c_low: float, c_high: float,
        sigma_low: float, sigma_high: float, t_edge_low: float, t_edge_high: float, /,
    ) -> None: ...
    def setparam_fitlimit_check(self, a: int, b_plus: int, b_minus: int, c: int, sigma: int, t_edge: int, /) -> None: ...
    def setparam_fitfix(self, a: float, b_plus: float, b_minus: float, c: float, sigma: float, t_edge: float, /) -> None: ...
    def setparam_fitfix_check(self, a: int, b_plus: int, b_minus: int, c: int, sigma: int, t_edge: int, /) -> None: ...
    def setparam_qualitycheck(
        self, dR_first: float, dR_last: float, dR_end: float, R_baseline: float,
        N_edge_per_N_baseline: float, DeltaT_edge: float, /,
    ) -> None: ...
    def setparam_qualitycheck_check(
        self, dR_first: int, dR_last: int, dR_end: int, R_baseline: int,
        N_edge_per_N_baseline: int, DeltaT_edge: int, /,
    ) -> None: ...
    def setparam_tagincrement(self, tagIncre: int, /) -> None: ...
    def setparam_bgdata(self, bgData: NDArray[np.float64], /) -> None:
        """Background projection: float64 array of 1920 values."""

@final
class UdbDataBuffer:
    """TMA analysis result of one tag."""
    def __init__(self) -> None: ...
    # --- read
    def readdata_timingedge(self) -> float:
        """Timing edge that passed the quality check (derivative)."""
    def readdata_timingedge_deriv(self) -> float: ...
    def readdata_timingedge_fit(self) -> float: ...
    def readdata_qualitycheck_isgoodtotal_deriv(self) -> int: ...
    def readdata_qualitycheck_isgoodtotal_fit(self) -> int: ...
    def readdata_qualitycheck_detail(self) -> tuple[float, float, float, float, float, float, float]:
        """(dR_first, dR_last, dR_end, R_baseline, DeltaT_edge,
        N_edge/N_baseline (deriv), N_edge/N_baseline (fit))."""
    def readdata_qualitycheck_isgooddetail(self) -> tuple[int, int, int, int, int, int, int, int, int]:
        """IsGood flags of (dR_first, dR_last, dR_end, R_baseline, DeltaT_edge,
        timing_edge_deriv, N_edge/N_baseline deriv, timing_edge_fit, N_edge/N_baseline fit)."""
    def readdata_fitparam_base(self) -> _Six: ...
    def readdata_fitparam_range(self) -> _Six: ...
    def readdata_runnumber(self) -> int: ...
    # --- set
    def setdata_timingedge_deriv(self, timingEdge: float, /) -> None: ...
    def setdata_timingedge_fit(self, timingEdge: float, /) -> None: ...
    def setdata_qualitycheck_isgoodtotal_deriv(self, isGood: int, /) -> None: ...
    def setdata_qualitycheck_isgoodtotal_fit(self, isGood: int, /) -> None: ...
    def setdata_qualitycheck_detail(
        self, dR_first: float, dR_last: float, dR_end: float, R_baseline: float, DeltaT_edge: float,
        N_edge_per_N_baseline_deriv: float, N_edge_per_N_baseline_fitting: float, /,
    ) -> None: ...
    def setdata_qualitycheck_isgooddetail(
        self, dR_first: int, dR_last: int, dR_end: int, R_baseline: int, DeltaT_edge: int,
        timing_edge_deriv: int, N_edge_per_N_baseline_deriv: int, timing_edge_fitting: int,
        N_edge_per_N_baseline_fitting: int, /,
    ) -> None: ...
    def setdata_fitparam_base(self, a: float, b_plus: float, b_minus: float, c: float, sigma: float, t_edge: float, /) -> None: ...
    def setdata_fitparam_range(self, a: float, b_plus: float, b_minus: float, c: float, sigma: float, t_edge: float, /) -> None: ...
    def setdata_runnumber(self, run: int, /) -> None: ...

@final
class UdbCtrlObject:
    """Connection to the User DataBase holding TMA results."""
    def __init__(self) -> None: ...
    def collect_udbparam(self, buffer: UdbParamBuffer, tmaID: int, highTag: int, tag: int, /) -> None:
        """Read the parameters valid at the tag into ``buffer``."""
    def collect_udbdata(self, buffer: UdbDataBuffer, tmaID: int, highTag: int, tag: int, /) -> int:
        """Read the result of one tag into ``buffer``; returns the valid flag."""
    def write_udbparam(self, buffer: UdbParamBuffer, tmaID: int, highTag: int, startTag: int, endTag: int, overwrite: bool = False, /) -> None: ...
    def write_udbparam_stoptag(self, tmaID: int, highTag: int, startTag: int, endTag: int, /) -> None: ...
    def write_udbdata(self, buffer: UdbDataBuffer, tmaID: int, highTag: int, tag: int, validFlag: int, overwrite: bool = False, /) -> None: ...
    def write_udbdata_validflag(self, tmaID: int, highTag: int, tag: int, validFlag: int, /) -> None: ...
    def delete_udbdata_inrange(self, tmaID: int, highTag: int, startTag: int, endTag: int, /) -> None: ...
    def open_udbdata_list(self, tmaID: int, highTag: int, startTag: int, endTag: int, /) -> None:
        """Start iterating over results in [startTag, endTag]; then call
        retrieve_udbdata() until it raises TMA_ERR_END_RETRIEVE; then close_udbdata_list()."""
    def retrieve_udbdata(self, buffer: UdbDataBuffer, /) -> tuple[int, int]:
        """Next result into ``buffer``; returns (tag, valid_flag)."""
    def close_udbdata_list(self) -> None: ...
    def change_group(self, groupName: str, /) -> None: ...
    def get_default_groupname(self) -> str: ...
    def get_readonly_groupname_list(self) -> tuple[str, ...]: ...
    def get_tmaid_list(self, serverType: int, /) -> tuple[int, ...]:
        """TMA analysis IDs on server type TMA_UDB_SERVER_TYPE_*."""
    def get_tmaid_servertype(self, tmaID: int, /) -> int: ...

def get_tmaid_range() -> tuple[int, int]:
    """(start_id, end_id) of the analysis IDs reserved for TMA."""
def get_tmaid(analyID: int, /) -> int:
    """Analysis ID -> TMA analysis ID."""
def get_analyid(tmaID: int, /) -> int:
    """TMA analysis ID -> analysis ID."""
def get_api_version() -> tuple[int, int, int]:
    """(major, minor, patch) of the tmapy API."""
